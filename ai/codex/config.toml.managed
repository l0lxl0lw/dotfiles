[tui]
# Mirrors the Claude Code statusline: model, cwd, repo, branch, then usage.
#
# Item ids verified present in codex-cli 0.146.0 by scanning the binary. Full set:
#   current-dir  project-root  project-name  git-branch  thread-title  thread-id
#   session-id   run-state     task-progress  model-with-reasoning
#   context-used context-remaining  context-window-size
#   used-tokens  total-input-tokens  total-output-tokens
#   five-hour-limit  weekly-limit  codex-version
# `model-name`, `usage-limit` and `secondary-usage-limit` all appear as strings in
# the 0.146.0 binary, but the TUI rejects them: "Ignored invalid status line
# items". Presence in the binary's string table is NOT membership in the accepted
# id set -- the descriptions ship for ids this build does not take. The list above
# is the verified-accepted set; only a running TUI can confirm an addition, since
# `codex debug prompt-input` parses an invalid id happily.
#
# `five-hour-limit` renders nothing on this account and that is expected, not a
# misconfiguration: the server sends one weekly window for Team plans and no
# 5-hour one, and a named item matches on window duration. It is kept anyway --
# it costs nothing while absent and comes back by itself if the plan ever reports
# a 5-hour window again. The plan-agnostic `usage-limit` pair would have shown
# whatever windows exist regardless of duration, but is not accepted here.
#
# Renders:
#   dir · repo · branch · Context N% used · 5h N% left · weekly N% left · model
# Location first (what changes most often), model last.
#
# This no longer matches ../claude/hooks/statusline.sh, and that is intentional.
# That script now renders two lines with progress bars, short labels, "used"
# instead of "left", always-on reset countdowns, and model and effort split into
# two items -- none of which this fixed id list can express. Keeping them identical meant clamping
# Claude down to what Codex can say, and the whole cost of that landed on the
# Claude side. So the item ORDER below still mirrors the order over there
# (location, context, quotas, model), but the rendering has diverged and should
# be expected to. Don't "resync" by reverting that file.
status_line = [
  "current-dir",
  "project-name",
  "git-branch",
  "context-used",
  "five-hour-limit",
  "weekly-limit",
  "model-with-reasoning",
]
status_line_use_colors = true
