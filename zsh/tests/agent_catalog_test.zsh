#!/usr/bin/env zsh
# Workflow agents reach Claude and Codex, and claude() syncs before launching.

setopt err_return nounset pipe_fail

repo_root=${0:A:h:h:h}
test_tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-catalog-test.XXXXXX"); test_tmp=${test_tmp:a}
trap 'command rm -rf -- "$test_tmp"' EXIT

# Ownership roots are computed from HOME when functions.zsh is sourced.
export HOME="$test_tmp/home" XDG_STATE_HOME="$test_tmp/state"
unset CODEX_HOME
mkdir -p "$HOME/.codex"
ln -s "$repo_root" "$HOME/dotfiles"

compdef() { :; }
source "$repo_root/zsh/functions.zsh"

fail() {
  print -u2 -- "FAIL: $1"
  return 1
}

assert_link_to() {
  local link=$1 expected=$2
  [[ -L "$link" ]] || fail "$link is not a symlink"
  [[ "${link:A}" == "${expected:A}" ]] || \
    fail "$link resolves to ${link:A}, expected ${expected:A}"
}

local -a roles=("$repo_root"/ai/codex/agents/*.toml(N))
(( ${#roles} == 10 )) || fail "expected 10 rendered Codex roles, found ${#roles}"

# Codex cannot spawn symlinked roles, so every role is a current copy. Earlier
# managed links are replaced, retired generated copies go, foreign roles stay,
# and a tier model missing from Codex's catalog is reported without failing.
local agents="$HOME/.codex/agents" generated='# Generated by ai/shared/agents/render.py from x; edit'
mkdir -p "$agents"
print -r -- 'name = "vendor"' > "$agents/vendor.toml"
print -r -- 'name = "foreign-same-name"' > "$agents/develop-plan.toml"
ln -s "$HOME/dotfiles/ai/codex/agents/codebase-locator.toml" "$agents/codebase-locator.toml"
ln -s "$HOME/dotfiles/ai/codex/agents/retired-link.toml" "$agents/retired-link.toml"
print -r -- "$generated" > "$agents/retired-copy.toml"
print -r -- "$generated" > "$agents/codebase-analyzer.toml"
print -r -- '{"models": [{"slug": "gpt-6-astra"}]}' > "$HOME/.codex/models_cache.json"

local warnings role
warnings=$(codex_merge_config 2>&1 >/dev/null)
for role in $roles; do
  [[ ${role:t} == develop-plan.toml ]] && continue
  [[ -f "$agents/${role:t}" && ! -L "$agents/${role:t}" ]] || fail "${role:t} is not a real file"
  cmp -s "$role" "$agents/${role:t}" || fail "${role:t} differs from the rendered role"
done
[[ "$(<"$agents/develop-plan.toml")" == 'name = "foreign-same-name"' ]] || fail "foreign same-name role was replaced"
[[ "$(<"$agents/vendor.toml")" == 'name = "vendor"' ]] || fail "foreign Codex role was not preserved"
[[ ! -e "$agents/retired-copy.toml" && ! -L "$agents/retired-link.toml" ]] || \
  fail "retired managed Codex roles were not pruned"
[[ "$warnings" == *"develop-plan.toml"*"not ours"* ]] || fail "foreign collision was not reported: $warnings"
[[ "$warnings" == *"tier 'fast'"*"tiers.json"* ]] || fail "missing unknown-model warning: $warnings"
[[ "$warnings" != *"tier 'standard'"* ]] || fail "known model was reported: $warnings"
local before=$(stat -f %i "$agents/codebase-locator.toml")
codex_merge_config >/dev/null 2>&1
[[ "$(stat -f %i "$agents/codebase-locator.toml")" == "$before" ]] || fail "unchanged role was rewritten"

# Claude: the wrapper syncs the workflow agents, forwards arguments and keeps the
# exit status of the real binary.
local fake_bin="$test_tmp/bin" report="$test_tmp/claude-args"
mkdir -p "$fake_bin"
print -r -- "#!/bin/sh
printf '%s\n' \"\$@\" > '$report'
exit 7" > "$fake_bin/claude"
chmod +x "$fake_bin/claude"
path=("$fake_bin" $path)

local exit_code=0
claude --agent "two words" >/dev/null || exit_code=$?
(( exit_code == 7 )) || fail "claude wrapper returned $exit_code, expected 7"
[[ "$(<"$report")" == $'--agent\ntwo words' ]] || fail "claude wrapper changed arguments"
for role in "$repo_root"/ai/claude/agents/workflow/*.md; do
  assert_link_to "$HOME/.claude/agents/workflow/${role:t}" "$role"
done
assert_link_to "$HOME/.claude/skills/develop-deliver" "$repo_root/ai/shared/skills/develop/develop-deliver"

# A declined Claude component still launches but performs no sync.
command rm -rf -- "$HOME/.claude" "$report"
mkdir -p "$XDG_STATE_HOME/dotfiles/disabled-sync"
touch "$XDG_STATE_HOME/dotfiles/disabled-sync/claude"
exit_code=0
claude >/dev/null || exit_code=$?
(( exit_code == 7 )) || fail "disabled claude wrapper returned $exit_code"
[[ ! -e "$HOME/.claude" ]] || fail "disabled claude wrapper synced the catalog"

print -- "agent catalog tests passed"
