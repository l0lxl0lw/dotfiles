# GitHub identity profiles: one gh account plus one git author per profile.
#
#   ghp            show the active profile
#   ghp list       list configured profiles
#   ghp <profile>  switch gh account, global git author and git's HTTPS credentials
#   ghp sync       bind repos to profiles by GitHub owner (see below)
#
# Profiles live outside the repo, one per line, in
# ${XDG_CONFIG_HOME:-~/.config}/dotfiles/github-profiles:
#
#   # profile  gh-user           email                     git author name
#   personal   my-handle         me@example.com            My Name
#   work       my-work-handle    me@company.example        My Name
#
# The active profile is whichever profile owns the active gh account, read from
# gh's hosts.yml, so a manual `gh auth switch` is reflected too. The prompt and
# ai/claude/hooks/statusline.sh both display it and flag a repo whose effective
# git email belongs to a different profile.
#
# Repos can instead be bound to a profile by GitHub owner, so no switching is
# needed. Bindings live outside the repo, in
# ${XDG_CONFIG_HOME:-~/.config}/dotfiles/github-repo-profiles:
#
#   # github-owner   profile
#   my-handle        personal
#   my-company-org   work
#
#   Run `ghp sync` after editing it to regenerate the git config.
#
# In a bound repo, git uses that profile's author and pushes with its gh account
# (via includeIf on the remote URL, so this holds for any git, not just this
# shell), the gh wrapper below runs gh as that account, and the prompt and status
# line show the bound profile. Unbound repos follow the active profile as before.

_ghp_file() { print -r -- "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/github-profiles"; }
_ghp_repo_file() { print -r -- "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/github-repo-profiles"; }
_ghp_git_dir() { print -r -- "${XDG_CONFIG_HOME:-$HOME/.config}/git/ghp"; }

# Profile bound to the current repo's origin owner, or fail.
_ghp_repo_profile() {
  local url owner file line
  local -a f
  file=$(_ghp_repo_file)
  [[ -r $file ]] || return 1
  url=$(git config --get remote.origin.url 2>/dev/null) || return 1
  owner=${url#*github.com[:/]}
  [[ $owner != "$url" ]] || return 1
  owner=${owner%%/*}
  while IFS= read -r line; do
    f=(${=line})
    (( ${#f} >= 2 )) && [[ ${f[1]} != \#* ]] || continue
    [[ ${(L)f[1]} == ${(L)owner} ]] && { print -r -- "${f[2]}"; return 0; }
  done < "$file"
  return 1
}

# gh user of the profile bound to the current repo, or fail.
_ghp_repo_user() {
  local profile entry
  profile=$(_ghp_repo_profile) || return 1
  entry=$(_ghp_lookup 1 "$profile") || return 1
  print -r -- "${${=entry}[2]}"
}

# Run gh as the repo's bound account. An explicit GH_TOKEN still wins.
gh() {
  local user token
  if [[ -z ${GH_TOKEN-} ]] && user=$(_ghp_repo_user) &&
     token=$(command gh auth token --hostname github.com --user "$user" 2>/dev/null) && [[ -n $token ]]; then
    GH_TOKEN=$token command gh "$@"
  else
    command gh "$@"
  fi
}

# Write one git include per profile (author + push account) and an includeIf per
# bound owner, then make sure the global gitconfig includes them.
_ghp_sync() {
  local file repo_file dir main gh_bin line owner profile entry user email name helper
  local -a f
  file=$(_ghp_file) repo_file=$(_ghp_repo_file) dir=$(_ghp_git_dir)
  [[ -r $repo_file ]] || { print -u2 "No bindings: create $repo_file (format in ~/dotfiles/zsh/github-profile.zsh)."; return 1; }
  gh_bin=$(whence -p gh) || { print -u2 'gh is not installed.'; return 1; }
  mkdir -p "$dir" || return 1
  main="$dir/bindings.gitconfig"
  print -r -- "# Generated by ghp sync from $repo_file; edit that file, not this one." > "$main"

  while IFS= read -r line; do
    f=(${=line})
    (( ${#f} >= 2 )) && [[ ${f[1]} != \#* ]] || continue
    owner=${f[1]} profile=${f[2]}
    entry=$(_ghp_lookup 1 "$profile") || { print -u2 "Skipping $owner: unknown profile $profile"; continue; }
    f=(${=entry})
    user=${f[2]} email=${f[3]} name=${f[4,-1]}
    # gh auth git-credential only answers for the active account, so each profile
    # gets its own helper that asks gh for that user's token.
    helper="!f() { [ \"\$1\" = get ] || exit 0; t=\$($gh_bin auth token --hostname github.com --user $user) || exit 0; echo username=$user; echo password=\$t; }; f"
    {
      print -r -- "# Generated by ghp sync: profile $profile."
      print -r -- "[user]"
      print -r -- "	name = $name"
      print -r -- "	email = $email"
      print -r -- '[credential "https://github.com"]'
      print -r -- "	username = $user"
      print -r -- "	helper ="
      print -r -- "	helper = \"${helper//\"/\\\"}\""
    } > "$dir/profile-$profile.gitconfig"
    {
      print -r -- "[includeIf \"hasconfig:remote.*.url:https://github.com/$owner/**\"]"
      print -r -- "	path = $dir/profile-$profile.gitconfig"
      print -r -- "[includeIf \"hasconfig:remote.*.url:git@github.com:$owner/**\"]"
      print -r -- "	path = $dir/profile-$profile.gitconfig"
    } >> "$main"
    print -r -- "$owner -> $profile ($user, $name <$email>)"
  done < "$repo_file"

  if [[ "$(git config --global --get-all include.path 2>/dev/null)" != *"$main"* ]]; then
    git config --global --add include.path "$main"
  fi
}

# Active gh user for github.com, parsed without running gh (it is on every prompt).
_ghp_active_user() {
  local hosts="${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}/hosts.yml" line in_host=0
  [[ -r $hosts ]] || return 1
  while IFS= read -r line; do
    if [[ $line == [^[:space:]]* ]]; then
      [[ $line == github.com:* ]] && in_host=1 || in_host=0
    elif (( in_host )) && [[ $line == '    user: '* ]]; then
      print -r -- "${line#    user: }"
      return 0
    fi
  done < "$hosts"
  return 1
}

# Print "profile gh-user email name" for the first line whose field $1 equals $2.
_ghp_lookup() {
  local field=$1 value=$2 file line
  local -a f
  file=$(_ghp_file)
  [[ -r $file ]] || return 1
  while IFS= read -r line; do
    f=(${=line})
    (( ${#f} >= 4 )) && [[ ${f[1]} != \#* ]] || continue
    [[ ${(L)f[$field]} == ${(L)value} ]] && { print -r -- "$line"; return 0; }
  done < "$file"
  return 1
}

# Prompt segment: [gh:work], or a red [gh:work git:personal] when the effective
# git email in the current repo belongs to another profile (or none).
github_profile_prompt() {
  local user entry email owner
  local -a f
  user=$(_ghp_repo_user) || user=$(_ghp_active_user) || return 0
  if entry=$(_ghp_lookup 2 "$user"); then
    f=(${=entry})
  else
    f=("$user")
  fi
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    email=$(git config user.email 2>/dev/null)
    if [[ -n $email && ${(L)email} != ${(L)f[3]-} ]]; then
      owner=$(_ghp_lookup 3 "$email") && owner=${${=owner}[1]} || owner=$email
      print -rn -- "%{$fg[red]%}[gh:${f[1]} git:${owner}]%{$reset_color%}"
      return 0
    fi
  fi
  print -rn -- "%{$fg[magenta]%}[gh:${f[1]}]%{$reset_color%}"
}

ghp() {
  local file entry user email name
  local -a f
  file=$(_ghp_file)
  if [[ ! -r $file ]]; then
    print -u2 "No profiles: create $file (format in ~/dotfiles/zsh/github-profile.zsh)."
    return 1
  fi

  case ${1-} in
    '')
      user=$(_ghp_active_user) || { print -u2 'gh is not logged in to github.com.'; return 1; }
      entry=$(_ghp_lookup 2 "$user") && f=(${=entry}) || f=('(unlisted)' "$user")
      print -r -- "profile:  ${f[1]}"
      print -r -- "gh user:  $user"
      print -r -- "git:      $(git config --global user.name) <$(git config --global user.email)>"
      email=$(git config user.email 2>/dev/null)
      if entry=$(_ghp_repo_profile); then
        print -r -- "this repo is bound to: $entry (git $(git config user.name) <$email>)"
      elif git rev-parse --is-inside-work-tree &>/dev/null && [[ $email != "$(git config --global user.email)" ]]; then
        print -r -- "this repo overrides git email: $email"
      fi
      ;;
    sync)
      _ghp_sync
      ;;
    list)
      user=$(_ghp_active_user)
      while IFS= read -r entry; do
        f=(${=entry})
        (( ${#f} >= 4 )) && [[ ${f[1]} != \#* ]] || continue
        [[ ${(L)f[2]} == ${(L)user-} ]] && print -rn -- '* ' || print -rn -- '  '
        print -r -- "${f[1]}  ${f[2]}  ${f[4,-1]} <${f[3]}>"
      done < "$file"
      ;;
    *)
      entry=$(_ghp_lookup 1 "$1") || { print -u2 "Unknown profile: $1 (see ghp list)"; return 1; }
      f=(${=entry})
      user=${f[2]} email=${f[3]} name=${f[4,-1]}
      if ! command gh auth switch --hostname github.com --user "$user" >/dev/null 2>&1; then
        print -u2 "gh has no login for $user. Run: gh auth login --hostname github.com --git-protocol https"
        print -u2 "(log in as $user in the browser), then rerun: ghp $1"
        return 1
      fi
      git config --global user.name "$name"
      git config --global user.email "$email"
      # Without this git pushes with whatever single github.com credential
      # osxkeychain cached, regardless of the active gh account.
      if [[ "$(git config --global --get-all credential.https://github.com.helper 2>/dev/null)" != *'gh auth git-credential'* ]]; then
        command gh auth setup-git --hostname github.com
      fi
      print -r -- "Switched to $1: gh $user, git $name <$email>"
      if git rev-parse --is-inside-work-tree &>/dev/null && [[ "$(git config user.email)" != "$email" ]]; then
        print -u2 "Note: this repo sets its own git email ($(git config user.email))."
      fi
      ;;
  esac
}

_ghp() {
  local file=$(_ghp_file) line
  local -a f profiles
  [[ -r $file ]] && while IFS= read -r line; do
    f=(${=line})
    (( ${#f} >= 4 )) && [[ ${f[1]} != \#* ]] && profiles+=(${f[1]})
  done < "$file"
  _arguments "1:profile:(list sync $profiles)"
}
if (( $+functions[compdef] )); then compdef _ghp ghp; fi
