{
  "version": 1,
  "checks": [
    {
      "id": "MEMORY_UNIT",
      "argv": ["/Users/zuzu/.local/share/life-memory-venv/bin/python", "-m", "unittest", "discover", "-s", "ai/memory", "-p", "test_*.py"],
      "cwd": ".",
      "env": {"PYTHONDONTWRITEBYTECODE": "1"},
      "env_keys": ["TMPDIR"],
      "kind": "test",
      "format": "unittest",
      "required": true,
      "allow_skips": false
    },
    {
      "id": "MEMORY_OPENCODE_SMOKE",
      "argv": ["python3.12", "ai/memory/smoke_opencode.py"],
      "cwd": ".",
      "env": {"PYTHONDONTWRITEBYTECODE": "1"},
      "env_keys": ["PATH", "TMPDIR"],
      "kind": "test",
      "format": "script",
      "success_pattern": "\"live_plugin_capture\": \"pass\"",
      "required": true,
      "allow_skips": false
    },
    {
      "id": "MEMORY_JS_SYNTAX",
      "argv": ["node", "--check", "ai/memory/life-memory.js"],
      "cwd": ".",
      "kind": "compile",
      "format": "exit",
      "required": true,
      "allow_skips": false
    }
  ]
}
